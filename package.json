{
  "name": "@devseed-ui/hug-chakra",
  "version": "0.1.0-beta",
  "description": "devseed UI Kit Hug for Chakra",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "yarn rollup -c ./rollup.config.mjs",
    "watch": "yarn rollup -c ./rollup.config.mjs -w",
    "clean": "rm -rf ./dist  ./.parcel-cache",
    "ts-check": "tsc --noEmit",
    "lint": "eslint ./lib --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/developmentseed/hug-chakra.git"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.28.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.28.0",
    "@emotion/react": "^11.14.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-inclusive-language": "^2.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "css",
    "framework",
    "front-end",
    "chakra",
    "react",
    "layout",
    "hug"
